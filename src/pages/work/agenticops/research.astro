---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const chapters = [['framing','Framing'],['method','Method'],['trust','Trust gradient'],['comfort','Comfort range'],['concerns','Confidence gap'],['voices','Customer voice'],['workflows','Use-case atlas'],['direction','Product direction']];
const roles = [['9','NIK'],['2','DEE'],['2','ALEX'],['1','JUDE'],['1','SAM']];
const findings = [
  ['Low operational risk','Automate','Customers welcomed automation for repetitive, efficiency-building work where outcomes were easy to inspect and reverse.'],
  ['Moderate operational risk','Recommend','For diagnosis and prioritisation, customers wanted AI to assemble evidence and propose the next best move.'],
  ['High operational risk','Approve','For remediation or configuration changes, explicit human approval remained the trust boundary.'],
];
const useCaseAtlas: Array<{title:string;rank:string;lead:string;groups:Array<[string,string[]]>}> = [
  {title:'Troubleshooting', rank:'01', lead:'Basic checks, suggestions and threat response made up roughly half of responses.', groups:[['Basic checks / self-healing',['Restart services or re-authenticate','Automate failover testing and node resync','Session-table balancing and time-series checks','Trace logs and packet evidence before opening a TAC case']],['Suggestions / fix',['Suggest solutions from known information and past TAC cases','Recommend configuration changes with expected impact','Trigger approved remediation workflows','Validate the fix and generate a report']],['Threat detection & enforcement',['Isolate a threat through a configuration change','Block related IP addresses','Use analytics to identify brute-force attacks','Shut down interfaces to stop data exfiltration']]]},
  {title:'Reviewing traffic flows', rank:'02', lead:'Customers wanted questions answered across logs, events and topology—not another place to manually correlate them.', groups:[['Log analysis',['Aggregate logs related to an issue','Create signals from noise','Review packet capture between source and destination']],['Traffic intelligence',['Review flows for policy, identity and violation context','Correlate data across tools, network topology and threat feeds','Generate a root-cause suggestion from combined evidence']],['Operator access',['Natural-language queries','On-demand analysis','TAC-level CLI access and reusable troubleshooting templates']]]},
  {title:'Threat monitoring', rank:'03', lead:'Customers wanted continuous monitoring to reduce alert noise, connect threat intelligence and prepare a response without hiding the evidence.', groups:[['Monitor & prioritise',['Continuously monitor threats and anomalous behaviour','Prioritise alerts by operational risk and likely impact','Correlate threat intelligence with local network context','Summarise why an alert requires attention']],['Investigate & explain',['Connect detections across devices, identities and traffic','Show the evidence behind a suspected attack','Identify related indicators and affected assets','Distinguish a meaningful threat from familiar background noise']],['Respond with control',['Recommend containment and remediation steps','Block related IP addresses after review','Isolate affected systems through approved configuration changes','Preserve an audit trail and allow operators to reverse an action']]]},
  {title:'Reports & audits', rank:'04', lead:'On-demand reporting through natural-language queries was the strongest reporting use case.', groups:[['Operational questions',['Devices with health problems','VPN login history for a user','Traffic between X and Y','Top X for a chosen period']],['Compliance reports',['Unused or loosely configured rules','Software versions and last upgrade dates','Vulnerabilities and insecure protocols','Alignment with a selected compliance framework']],['Executive reports',['What happened?','What was done to remediate it?','What prevents it from happening again?']]]},
  {title:'Licensing', rank:'05', lead:'Understanding the licence and managing the smart account emerged as two distinct jobs.', groups:[['Licensing assistant',['Explain features, SKUs, pricing and package options','Compare requirements, features and quotes','Explain bundle relationships and consequences of missing licences','Connect licensing choices to throughput and limits']],['Smart account management',['Consolidate smart and virtual accounts','Search licences efficiently','Track terms and remind teams before renewal','Explain expiry and recommend replacements','Clean up unused licences']],['Guided application',['Advise on architecture resizing','Provide order status and escalation paths','Apply licences to devices through a reviewable workflow']]]},
  {title:'Configuration', rank:'06', lead:'The opportunity ranged from bulk work to migration support—but confidence rose when changes remained inspectable.', groups:[['Lifecycle & deployment',['Bulk-create, import, modify or delete objects','Integrate change requests, approvals and policy creation','Template-based deployment for ACL, NAT, IPS and SNMP','Integrate with ServiceNow, ISE, XDR, SIEM and SD-WAN tools']],['Configuration assistance',['Enforce naming standards','Scan for conflicts, duplicates and shadows before deployment','Suggest best-practice and security-posture improvements','Analyse whether a requested change is required']],['Migration & assurance',['Match the configuration style of the source device','Verify post-migration state against pre-migration state','Simulate the effect of a rule or policy change','Document changes and preserve version history']]]},
];
const customerQuotes = [
  {quote:'I would like to see more integrated AI. I am seeing AI for this, AI for that and AI for another thing—lots of separate AI features that don’t integrate with each other. Links between them are missing, somehow.', source:'Kenvue · Global Network Engineering Director'},
  {quote:'If and when the AI feature comes out, it’s got to be very refined. Even if it’s limited in how much it can do, it’s better that it does that limited stuff really well than trying to do too much not so well.', source:'Core BTS · Technical Solutions Director'},
];
---

<BaseLayout title="AgenticOps Research Report" description="The customer research behind the AgenticOps product direction.">
  <main class="report-shell">
    <a class="back" href="/work/agenticops#agentic-research">← Back to Research signals</a>
    <header class="report-hero">
      <p>Case Study 02 · Research report</p>
      <h1>Where AI has the right to act.</h1>
      <div><p>Making firewall operations more intuitive and efficient meant understanding more than desired features. We needed to locate the boundary between useful assistance and unacceptable operational risk.</p><aside>AI was welcome at the table. Customers simply preferred it not rearrange the firewall without asking.</aside></div>
    </header>

    <nav class="report-nav" aria-label="Research report chapters">{chapters.map(([id,label]) => <a href={`#${id}`}>{label}</a>)}</nav>

    <section id="framing" class="report-section framing">
      <p class="eyebrow">01 / Research framing</p><h2>The real question was not “What can AI do?”</h2>
      <div class="split"><p>The product discussion began with a broad field of AI possibilities. Research reframed it around customer work: where effort accumulated, where evidence was fragmented and where a wrong action could affect live service.</p><blockquote>Where should AI help, where should it recommend—and where must a person remain visibly in charge?</blockquote></div>
    </section>

    <section id="method" class="report-section method">
      <p class="eyebrow">02 / Study design</p><h2>Broad enough to find patterns. Deep enough to understand why.</h2>
      <div class="numbers"><article><strong>267</strong><span>Screener responses</span></article><article><strong>64</strong><span>Survey responses</span></article><article><strong>15</strong><span>Interviews</span></article></div>
      <div class="method-note"><b>Method</b><p>Secondary research followed by a combination of survey and customer interviews.</p></div>
      <div class="roles"><p>Interview mix</p>{roles.map(([count,role]) => <article><strong>{count}×</strong><span>{role}</span></article>)}</div>
    </section>

    <section id="trust" class="report-section">
      <p class="eyebrow">03 / Primary insight</p><h2>Trust was risk-tiered.</h2>
      <p class="lead">Customers supported greater automation for low-risk, efficiency-boosting tasks. As task criticality and potential service impact rose, they expected tighter oversight and clearer evidence.</p>
      <div class="gradient">{findings.map(([risk,mode,copy],i) => <article><span>{risk}</span><strong>{mode}</strong><p>{copy}</p><i>{String(i+1).padStart(2,'0')}</i></article>)}</div>
    </section>

    <section id="comfort" class="report-section comfort">
      <p class="eyebrow">04 / Customer comfort range</p><h2>Pain alone did not determine priority.<br /><span>Comfort mattered too.</span></h2>
      <p class="lead">Customers rated both the difficulty of a task and their comfort with introducing an automated workflow. The useful territory sat where recurring pain met credible customer permission.</p>
      <div class="comfort-map" role="img" aria-label="Conceptual map of customer comfort with automation against task difficulty">
        <span class="axis-y">Task difficulty ↑</span><span class="axis-x">Comfort with automation →</span><b class="zone">High pain<br/>High comfort</b>
        <i style="--x:82%;--y:72%">Prerequisite checks</i><i style="--x:75%;--y:78%">Initial FMC setup</i><i style="--x:69%;--y:84%">Initial FTD setup</i><i style="--x:63%;--y:58%">Integrations</i><i style="--x:58%;--y:72%">Optimise policies</i><i style="--x:49%;--y:77%">Cleanup rules</i><i style="--x:41%;--y:43%">Multi-team policy management</i>
      </div>
      <div class="comfort-read"><article><span>Comfortable starting point</span><b>Staging and bounded setup</b><p>Prerequisite checks, navigation, initial FMC/FTD configuration and licence-based feature activation clustered as comfortable, comparatively easy automation.</p></article><article><span>High-value middle</span><b>Optimisation with evidence</b><p>Integrations, policy optimisation, cleanup and deployment validation carried useful comfort—but required context, preview and reversibility.</p></article><article><span>Proceed with care</span><b>Shared policy decisions</b><p>Work involving multiple teams or wider service consequences required more explanation and tighter human control.</p></article></div>
    </section>

    <section id="concerns" class="report-section concerns">
      <p class="eyebrow">05 / Confidence gap</p><h2>Accuracy without accountability was not enough.</h2>
      <div class="concern-grid"><article><b>Hallucination</b><p>Could the agent invent or misread operational context?</p></article><article><b>Unexpected outcome</b><p>Could a reasonable-looking action create unintended service impact?</p></article><article><b>Unclear responsibility</b><p>Who remains accountable when the agent recommends—or performs—the change?</p></article></div>
      <aside>The design implication was clear: show the evidence, name the consequence and keep consequential action reviewable. “Trust me” is charming from a colleague; less so from a firewall.</aside>
    </section>

    <section id="voices" class="report-section voices">
      <p class="eyebrow">06 / Customer voice</p><h2>The ambition was broad.<br /><span class="voice-heading-line">The permission was precise.</span></h2>
      <div class="quote-wall">{customerQuotes.map((item,index) => <blockquote class:list={{featured:index===0}}><p>“{item.quote}”</p><cite>{item.source}</cite></blockquote>)}</div>
      <p class="voice-note">Together, the quotes sharpened two requirements: build one connected operating experience, and make a smaller set of capabilities exceptionally dependable before widening autonomy.</p>
    </section>

    <section id="workflows" class="report-section">
      <p class="eyebrow">07 / Use-case atlas</p><h2>The opportunity was ranked—and then unpacked.</h2>
      <p class="lead">The recommended sequence was: troubleshooting → reviewing traffic flows → monitoring threats → reports and audits → licensing → configuration → staging. The sequence balanced customer value, task pain and comfort with automation.</p>
      <div class="atlas">{useCaseAtlas.map(item => <article class="atlas-row"><header><span>{item.rank}</span><div><h3>{item.title}</h3><p>{item.lead}</p></div></header><div class="atlas-groups">{item.groups.map(([title,points]) => <section><h4>{title}</h4><ul>{points.map(point => <li>{point}</li>)}</ul></section>)}</div></article>)}</div>
    </section>

    <section id="direction" class="report-section direction">
      <p class="eyebrow">08 / From evidence to direction</p><h2>Assist first. Explain always. Act with permission.</h2>
      <div class="principles"><article><span>Control</span><b>Match automation to operational risk.</b></article><article><span>Accountability / undo</span><b>Preserve audit trails, overrides and reversal.</b></article><article><span>Transparency</span><b>Show reasoning, data sources and proposed actions.</b></article><article><span>Accuracy</span><b>Continuously reduce hallucinations and errors.</b></article></div>
      <div class="decision-flow"><article><span>Observation</span><b>Operators lose time assembling context across fragmented tools.</b></article><i>→</i><article><span>Insight</span><b>AI creates value fastest when it reduces search and synthesis cost.</b></article><i>→</i><article><span>Decision</span><b>Build a connected insight layer, then stage action behind visible approval.</b></article></div>
      <a class="return-card" href="/work/agenticops#agentic-research"><span><small>Continue the story</small><strong>Return to Case Study 02</strong></span><b>Back to Research signals →</b></a>
    </section>
  </main>
</BaseLayout>

