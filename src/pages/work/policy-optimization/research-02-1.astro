---
import BaseLayout from '../../../layouts/BaseLayout.astro';

const chapters = [
  ['current-state', 'Current state'],
  ['research-questions', 'Research questions'],
  ['contextual-study', 'Contextual study'],
  ['customer-problems', 'Customer problems'],
  ['synthesis', 'Synthesis'],
  ['themes', 'Affinity themes'],
  ['implications', 'Design implications'],
];

const researchQuestionGroups = [
  {
    number: '01',
    title: 'Organisation & environment',
    lead: 'Understand the customer',
    questions: [
      'How many network-operations teams are in the organisation?',
      'Do teams have their own labs, and how are they used?',
      'How are systems classified?',
      'What are the current firewall pain points?',
    ],
  },
  {
    number: '02',
    title: 'Network & topology',
    lead: 'Understand the operating landscape',
    questions: [
      'How many devices and branch offices are managed?',
      'What does the topology look like?',
      'How is that topology managed today?',
      'How are devices distributed across the network?',
    ],
  },
  {
    number: '03',
    title: 'Policy-management practices',
    lead: 'Follow the work as it happens',
    questions: [
      'What does a typical day or week look like?',
      'How often are policies managed?',
      'What are the main challenges, and how are they handled?',
      'Which policies and objects are used across the network?',
      'How do teams define micro-segmentation?',
    ],
  },
  {
    number: '04',
    title: 'Deployment confidence',
    lead: 'Understand the path to change',
    questions: [
      'How would teams want to deploy?',
      'What information creates confidence in a policy change?',
      'How long should the dual data plane run?',
    ],
  },
  {
    number: '05',
    title: 'Upgrade & ideal workflow',
    lead: 'Reveal risk and unmet needs',
    questions: [
      'How do teams upgrade their firewall software?',
      'What information creates confidence in an upgrade?',
      'If they could fix anything about the workflow, what would it be?',
    ],
  },
];

const customerProblemGroups = [
  {
    title: 'ACL & rule management',
    tone: 'problem-coral',
    findings: [
      'ACL management is entirely manual — no tooling exists',
      'Rule ordering errors go undetected for months',
      'No alerting for overlapping or conflicting rules',
      'Searching within large rulesets is nearly impossible',
      'Moving rules in the UI is confusing and error-prone',
      'No save prompt when switching between rules',
    ],
  },
  {
    title: 'Policy lifecycle',
    tone: 'problem-yellow',
    findings: [
      'No version control on firewall policies',
      'Hit counts are wiped on every upgrade — losing audit trail',
      "Can't determine if rules are actually in use",
      'No lifecycle workflow for automated rule cleanup',
      'Policy metadata tracked outside FMC in separate tools',
    ],
  },
  {
    title: 'Approval workflow',
    tone: 'problem-violet',
    findings: [
      'Multi-team approval creates weeks of delay',
      'InfoSec approval is slow, painful and disconnected',
      'Incomplete requests cause endless back-and-forth',
      'No automated approval workflow exists',
      'Approval tracking lives in ServiceNow, not FMC',
    ],
  },
  {
    title: 'Upgrade & deployment',
    tone: 'problem-orange',
    findings: [
      'Upgrading consumes every weekend for an entire quarter',
      '3-stage deployment cycle is entirely manual and slow',
      'Deployment gives no time estimate and gets stuck',
      'Multiple firmware layers must upgrade simultaneously',
      'No choice between stable vs. latest upgrade path',
      'Testing is entirely manual with no automation',
    ],
  },
  {
    title: 'Disaster recovery',
    tone: 'problem-pink',
    findings: [
      'DR firewalls in separate data centers fall out of sync',
      'Forgetting to update DR firewall ACLs is common',
      'No mechanism to keep DR policies synchronized',
    ],
  },
  {
    title: 'Team collaboration',
    tone: 'problem-blue',
    findings: [
      '3 teams must coordinate for every policy change',
      'Teams just pass ServiceNow tickets and rarely talk',
      "Concurrent edits overwrite each other's changes",
      "Application teams don't know which firewall to request",
    ],
  },
  {
    title: 'Monitoring & validation',
    tone: 'problem-cyan',
    findings: [
      'Health monitoring only shows above-threshold, not below',
      'Pre/post upgrade verification is manual graph comparison',
      'Quarterly traffic patterns make rule validation unreliable',
      'FMC hit count visibility is lost on version changes',
    ],
  },
  {
    title: 'Segmentation & distributed firewall',
    tone: 'problem-green',
    findings: [
      'Micro-segmentation is desired but impossible today',
      'Network zone segmentation is the only option',
      'Distributed FW changes require cascading ticket chains',
    ],
  },
  {
    title: 'Object group management',
    tone: 'problem-lilac',
    findings: [
      "Object Groups can't be shared across different firewalls",
      'Same OG exists in multiple versions with no sync',
      "Updating one OG doesn't propagate to linked groups",
      'Different FW types operate with different OG policies',
    ],
  },
  {
    title: 'Intelligence & trust',
    tone: 'problem-rose',
    findings: [
      'FW provides no intelligence to prevent misconfigurations',
      'Application dependency mapping requires manual agents',
      'Users are skeptical about AI and external policy storage',
    ],
  },
];

const themes = [
  { number: '01', title: 'Awareness and discoverability', copy: 'Policy health was not continuously visible. Administrators had to know where to look, initiate analysis and assemble an understanding from separate signals.', color: 'violet' },
  { number: '02', title: 'Understanding and language', copy: 'Technical anomaly labels described what the system detected, but did not consistently explain the operational consequence or the relationship between rules.', color: 'blue' },
  { number: '03', title: 'Evidence and trust', copy: 'People needed to inspect hit history, rule action, zones, networks, ports and related policy context before trusting a recommendation.', color: 'cyan' },
  { number: '04', title: 'Prioritisation', copy: 'A large set of findings did not reveal where to begin. Severity alone was insufficient without usage, exposure and consequence.', color: 'green' },
  { number: '05', title: 'Remediation and control', copy: 'Disabling and deleting were not equivalent decisions. Operators needed a reversible path, an explicit preview and the ability to undo a proposed change.', color: 'yellow' },
  { number: '06', title: 'Workflow and governance', copy: 'Policy optimisation crossed devices, roles and maintenance windows. Scheduling and change history were part of the core experience, not administrative extras.', color: 'orange' },
  { number: '07', title: 'Collaboration and scale', copy: 'Evidence had to be legible to network, IT and security roles so that remediation could be reviewed and coordinated across teams.', color: 'coral' },
];

const findingDetails: Record<string, string> = {
  'ACL management is entirely manual — no tooling exists': "We don't have a proper ACL management tool and this leads to pain across multiple problems. Someone requests an ACL — need to know who to contact — we don't have any provision on that.",
  'Rule ordering errors go undetected for months': "We accidentally had the order of rules wrong — it wasn't clear they had rules in the wrong order. A month or longer it stayed like that. There was no warning.",
  'No alerting for overlapping or conflicting rules': "'I can send an email out anywhere' — there was no warning. Hey, you have overlapping rules! How can we make it easier to alert them?",
  'Searching within large rulesets is nearly impossible': 'Because of the innumerous rules, participants suggested a way of searching to find the rule they want to switch to from the overlay.',
  'Moving rules in the UI is confusing and error-prone': 'Finding where to go to move a rule was challenging for most. Drag-and-drop for groups of rules was expected.',
  'No save prompt when switching between rules': 'Prompting to save changes made to a rule before switching to a new one is desirable. The actions need to be more cohesive within the user flow.',
  'No version control on firewall policies': "We don't have any version control on the policies yet. No way we can get approval within the cycle. Git for config — but not for ACLs.",
  'Hit counts are wiped on every upgrade — losing audit trail': 'When an ACL is upgraded, all of the hit counts go away. We should synchronize the counts when we do dual data plane. The visibility and metadata is not there.',
  "Can't determine if rules are actually in use": 'Certain applications speak only once a quarter, so the ACL counts could be low. Some lines are not being hit — then we look at metadata and reach out to people.',
  'No lifecycle workflow for automated rule cleanup': 'Delete or retain the ACL. The team gets notification that their application is being deleted. The usual lifecycle is based on metadata — automation will reach out to clients.',
  'Policy metadata tracked outside FMC in separate tools': 'We document that in a separate tool outside of FMC, then go back and remove it. The metadata is the problem. It is an essential part of the approval process.',
  'Multi-team approval creates weeks of delay': 'Getting approval from the InfoSec team is a pain point. When we edit a policy, they have to approve it. We document that in a separate tool outside of FMC.',
  'InfoSec approval is slow, painful and disconnected': 'Any IT change has to go through change-board approval, peer approval and management approval — generally three people, but it could be more.',
  'Incomplete requests cause endless back-and-forth': "The user doesn't know what firewall they are traversing. 'I need this thing to talk to this other thing.' We don't get what ports they want. The information is incomplete.",
  'No automated approval workflow exists': 'What takes so long is multiple groups interacting and approving. It would be nice to have some automated approval — especially when something could potentially cause an issue.',
  'Approval tracking lives in ServiceNow, not FMC': 'We use ServiceNow. Git is used for config changes, but not ACLs. The approval process is in a separate tool; Network Services runs checks and asks InfoSec Ops for approval.',
  'Upgrading consumes every weekend for an entire quarter': 'Upgrading takes away every single weekend during upgrade time — it can take almost a whole quarter. Reasons include a new feature, an operational issue or a security vulnerability.',
  '3-stage deployment cycle is entirely manual and slow': 'Three steps: test in the lab, limited deployment for weeks, then general deployment. We see bugs at all three points — all manual.',
  'Deployment gives no time estimate and gets stuck': "Deployment doesn't convey how long it will take. Sometimes deployment gets stuck and we have to raise a case to resolve it.",
  'Multiple firmware layers must upgrade simultaneously': 'Multiple layers of upgrades — firmware upgrade, FMC upgrade — mean several upgrades and downtime. FMC and FTD upgrades are needed at the same time.',
  'No choice between stable vs. latest upgrade path': 'Give users a choice: some want the newest release, others want to wait for the Gold Star from Cisco. Add the software.cisco.com link in the UI.',
  'Testing is entirely manual with no automation': 'All testing is manual — test cases, DBG, connectivity, failovers and upgrades. We generate test traffic, monitor it and go back through the logs.',
  'DR firewalls in separate data centers fall out of sync': 'In disaster recovery, an app runs in the primary data centre while the backup is not running. When disaster strikes, the two firewalls can be out of sync.',
  'Forgetting to update DR firewall ACLs is common': "It is easy for ACL rules to get out of sync because they are in two different data centres. 'Oh, I forgot to update the ACLs' — entirely different firewalls, separate by design.",
  'No mechanism to keep DR policies synchronized': 'Something we should keep in mind is disaster recovery. When we update one, we sometimes forget to update the other. How do we keep them in sync?',
  '3 teams must coordinate for every policy change': 'Three teams work together: IT owns the platform, Security owns the policy and the application team has the need. Multiple organisations interact without clear ownership.',
  'Teams just pass ServiceNow tickets and rarely talk': 'They just pass ServiceNow tickets to each other and really do not talk much. Each team makes changes to its own firewall independently.',
  "Concurrent edits overwrite each other's changes": 'Multiple network admins work on the same firewall policies. Changes made by one can be unintentionally overwritten by another — leading to conflicts and security vulnerabilities.',
  "Application teams don't know which firewall to request": "The person in the application team has something on-prem and wants to access SaaS. They don't know what firewall they are traversing unless they are super savvy.",
  'Health monitoring only shows above-threshold, not below': "Health checks monitor whether something is above the threshold, but do not show what is happening below it. Teams check traffic before and after and compare graphs manually.",
  'Pre/post upgrade verification is manual graph comparison': 'We have a checklist: traffic before and after, CPU and memory. It takes time to inspect the graphs and compare how the firewall is handling traffic inside FMC.',
  'Quarterly traffic patterns make rule validation unreliable': 'Certain traffic only appears once a quarter — for example, financial information. How are we going to test with traffic that only appears once a quarter?',
  'FMC hit count visibility is lost on version changes': 'FMC hit-count visibility is there, but when customers upgrade we lose their hit count. The visibility will not be there.',
  'Micro-segmentation is desired but impossible today': 'No one really does application segmentation today — it takes too much time and is too complicated. They use macro-segmentation but would like micro-segmentation.',
  'Network zone segmentation is the only option': "They do network-zone segmentation. We are doing micro-segmentation internally, but today we don't have that visibility. Service-to-service level is the goal.",
  'Distributed FW changes require cascading ticket chains': 'One team needs to change its firewall, then another team changes theirs. The work moves through a chain of ServiceNow tickets.',
  "Object Groups can't be shared across different firewalls": "Give networking teams these object groups and let them replicate across networks. There is no way to share and manage Object Groups across different networks.",
  'Same OG exists in multiple versions with no sync': "Policies are not the same. One firewall has version 6 of a DNS server, another has version 2. There is no way to manage object groups across all firewalls.",
  "Updating one OG doesn't propagate to linked groups": 'Grouping of groups? If you update one, should the other update? Group A manages the corporate firewall and Group B manages the lab firewall. They should be consistent.',
  'Different FW types operate with different OG policies': 'Corporate, data-centre, lab and CCI firewalls all operate with different object-group policies. We want a common set of object groups across them.',
  'FW provides no intelligence to prevent misconfigurations': "The firewall should tell you as much as it can when it thinks you're making a mistake. It should provide valuable metadata and stop you from making that mistake.",
  'Application dependency mapping requires manual agents': "Application dependency: 'This is what you currently have — does this look good?' The user has no idea. You have to install an agent on those end hosts for it to work.",
  'Users are skeptical about AI and external policy storage': 'A little skeptical about AI. There may be an issue with having policies outside the data centre. AI-assisted troubleshooting raises hybrid-deployment concerns.',
};
---

<BaseLayout
  title="Contextual research · Policy Analyzer & Optimizer"
  description="The detailed contextual-research narrative for the Policy Analyzer & Optimizer case study."
>
  <article class="research-detail">
    <header class="detail-hero shell">
      <a class="back-link" href="/work/policy-optimization#research"><span aria-hidden="true">←</span> Back to Case Study 01</a>
      <p class="eyebrow">Case study 01 · Contextual research</p>
      <h1>Understanding the work <em>before</em> simplifying it.</h1>
      <div class="hero-summary">
        <div class="hero-summary-item">
          <span>Where we looked</span>
          <p>The research moved beyond the policy interface to understand how administrators monitor, interpret, prioritise and act across a wider operational system.</p>
        </div>
        <div class="hero-summary-item hero-summary-finding">
          <span>What changed the brief</span>
          <p>Policy optimisation was not only a detection problem. It was a confidence, consequence and governance problem.</p>
        </div>
        <p class="hero-summary-hook"><span aria-hidden="true">↳</span> The dashboard could spot the mess. Research had to explain why nobody felt safe cleaning it up.</p>
      </div>
    </header>

    <div class="detail-layout shell">
      <nav class="detail-nav" aria-label="Contextual research chapters">
        <p>On this page</p>
        <ol>{chapters.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}</ol>
      </nav>

      <main class="detail-story">
        <section id="current-state" class="detail-section">
          <p class="section-kicker">01 / Current-state experience</p>
          <h2>The dashboard revealed the cost of fragmented problems—but not where to intervene.</h2>
          <div class="two-column-copy">
            <p>Cisco’s TAC engineers were spending day and night investigating customer problems across the firewall-management experience. The research estimated that, in the preceding year, Cisco had spent close to <strong>US$5 million</strong> resolving these serviceability requests—making the fragmented experience a material cost to the business as well as to customers.</p>
            <p>The dashboard made the breadth of those requests visible across multiple categories. Policy-related problems formed a major part of the picture, but the evidence was dispersed across the system. TAC engineers and product teams could see <em>where problems appeared</em> without a shared view of <em>where to look first, what was connected, or what to address next</em>.</p>
          </div>
          <div class="current-state-panel">
            <figure class="tac-dashboard">
              <picture>
                <source srcset="/images/policy-case/tac-technical-advisory-dashboard.webp" type="image/webp">
                <img src="/images/policy-case/tac-technical-advisory-dashboard.png" alt="TAC Technical Advisory Committee Core Cohesion dashboard showing a radial classification of service requests and a General Connectivity Problems case grouping" width="1698" height="909" loading="lazy">
              </picture>
              <figcaption><span>Actual research artifact</span>TAC Technical Advisory Committee · Core Cohesion dashboard</figcaption>
            </figure>
            <ol class="breakdown-list">
              <li><span>Signal was distributed</span><p>Customer issues appeared across the firewall-management system rather than as one connected problem narrative.</p></li>
              <li><span>Categories required interpretation</span><p>The dashboard classified requests, but teams still had to translate categories into causes, relationships and business consequences.</p></li>
              <li><span>Focus remained unclear</span><p>TAC and product teams could see the scale of the problem, but not where intervention would create the greatest impact.</p></li>
            </ol>
          </div>
        </section>

        <section id="research-questions" class="detail-section">
          <p class="section-kicker">02 / Research questions</p>
          <h2>The inquiry moved from operating context to confident change.</h2>
          <p class="question-intro">The interview guide explored the environment around policy work before narrowing into the decisions administrators make during analysis and remediation.</p>
          <ol class="question-grid">
            {researchQuestionGroups.map((group) => (
              <li>
                <header><span>{group.number}</span><div><p>{group.lead}</p><h3>{group.title}</h3></div></header>
                <ul>{group.questions.map((question) => <li>{question}</li>)}</ul>
              </li>
            ))}
          </ol>
          <aside class="question-focus"><span>Where the inquiry converged</span><p>Recognising attention → interpreting anomalies → prioritising risk → verifying evidence → remediating safely → fitting change into enterprise governance.</p></aside>
        </section>

        <section id="contextual-study" class="detail-section dark-section">
          <p class="section-kicker">03 / Contextual study</p>
          <h2>The interface was only one part of the job.</h2>
          <p class="section-intro">Field and contextual research looked at the environment around policy management: the tools administrators monitored, the interruptions they handled, the people involved and the checks performed before a change was considered safe.</p>
          <div class="field-grid">
            <article><span>Observe</span><h3>Follow the real workflow</h3><p>Understand how a policy problem is noticed, investigated and escalated across tools rather than studying isolated screens.</p></article>
            <article><span>Listen</span><h3>Capture decision language</h3><p>Learn how administrators describe risk, evidence and confidence in their own operational vocabulary.</p></article>
            <article><span>Probe</span><h3>Study the moment of action</h3><p>Identify what people verify immediately before disabling, deleting or postponing a rule change.</p></article>
            <article><span>Connect</span><h3>Map the wider system</h3><p>Include devices, roles, maintenance windows and audit expectations in the experience model.</p></article>
          </div>
          <blockquote>Administrators were not asking the product to make the decision for them. They were asking it to make the decision understandable.</blockquote>
        </section>

        <section id="customer-problems" class="detail-section customer-problems-section">
          <p class="section-kicker">04 / Customer problems</p>
          <h2>43 findings across 10 problem areas.</h2>
          <p class="problem-intro">The findings below reproduce every card from the original Customer problems group. The group order and color families are retained while the cards are rebuilt in the portfolio’s editorial system.</p>
          <div class="problem-groups">
            {customerProblemGroups.map((group, groupIndex) => (
              <section class={`problem-group ${group.tone}`} aria-labelledby={`problem-group-${groupIndex}`}>
                <header><span>{String(groupIndex + 1).padStart(2, '0')}</span><h3 id={`problem-group-${groupIndex}`}>{group.title}</h3><p>{group.findings.length} findings</p></header>
                <ol>{group.findings.map((finding, findingIndex) => (
                  <li>
                    <span>{String(findingIndex + 1).padStart(2, '0')} · {group.title}</span>
                    <p>{finding}</p>
                    <blockquote>{findingDetails[finding]}</blockquote>
                  </li>
                ))}</ol>
              </section>
            ))}
          </div>
        </section>

        <section id="synthesis" class="detail-section synthesis-section">
          <p class="section-kicker">05 / Synthesis</p>
          <section class="workshop-opening" aria-labelledby="workshop-opening-title">
            <div class="workshop-intro">
              <h2 id="workshop-opening-title">Two days to turn scattered evidence into a shared picture.</h2>
              <p>Across a two-day workshop, the team regrouped observations, challenged assumptions and synthesised the customer evidence into the themes that shaped the study.</p>
            </div>
            <div class="workshop-gallery">
              <figure class="workshop-day">
                <img src="/images/policy-case/workshop-day-1.png" alt="Workshop participants presenting, discussing and arranging research notes together during the first day" width="1718" height="423" loading="lazy">
                <figcaption><span>Day 01</span>Framing the problem and regrouping observations</figcaption>
              </figure>
              <figure class="workshop-day">
                <img src="/images/policy-case/workshop-day-2.png" alt="Workshop participants working around tables and a shared screen while synthesising evidence on the second day" width="1718" height="430" loading="lazy">
                <figcaption><span>Day 02</span>Clustering evidence and aligning on research themes</figcaption>
              </figure>
            </div>
          </section>
          <div class="synthesis-process">
            <h2>From observations to patterns, then from patterns to product direction.</h2>
            <div class="synthesis-flow" aria-label="Research synthesis sequence">
              <article><span>01</span><strong>Raw evidence</strong><p>Interview notes, contextual observations, workflow steps, dashboard findings and moments of hesitation.</p></article>
              <b aria-hidden="true">→</b>
              <article><span>02</span><strong>Affinity clustering</strong><p>Related observations grouped by recurring behaviour, unmet need, risk and operational constraint.</p></article>
              <b aria-hidden="true">→</b>
              <article><span>03</span><strong>Research themes</strong><p>Clusters consolidated into the themes that explained why policy recommendations were difficult to trust and act on.</p></article>
              <b aria-hidden="true">→</b>
              <article><span>04</span><strong>Design implications</strong><p>Each theme translated into a requirement for orientation, evidence, control or governance.</p></article>
            </div>
            <aside class="synthesis-note"><span>Why this mattered</span><p>The affinity map prevented the team from treating every observation as an isolated feature request. It exposed the connected system beneath the individual comments.</p></aside>
          </div>
        </section>

        <section id="themes" class="detail-section">
          <p class="section-kicker">06 / Affinity themes</p>
          <h2>Seven themes organised the evidence.</h2>
          <div class="theme-stack">
            {themes.map((theme) => <article class={`theme-card ${theme.color}`}><span>{theme.number}</span><h3>{theme.title}</h3><p>{theme.copy}</p></article>)}
          </div>
        </section>

        <section id="implications" class="detail-section implication-section">
          <p class="section-kicker">07 / What the research changed</p>
          <h2>The solution needed to support judgment—not simply automate cleanup.</h2>
          <div class="implication-list">
            <article><span>Observation</span><p>Policy health was difficult to recognise across fragmented signals.</p><b aria-hidden="true">→</b><span>Design implication</span><p>Provide an orienting health summary with direct paths to supporting evidence.</p></article>
            <article><span>Observation</span><p>Anomaly terminology did not communicate operational consequence.</p><b aria-hidden="true">→</b><span>Design implication</span><p>Explain what is wrong, why it matters and how the affected rules relate.</p></article>
            <article><span>Observation</span><p>High-risk changes required repeated manual verification.</p><b aria-hidden="true">→</b><span>Design implication</span><p>Keep expert fields visible and make recommendations inspectable before action.</p></article>
            <article><span>Observation</span><p>Deletion felt irreversible and unsafe.</p><b aria-hidden="true">→</b><span>Design implication</span><p>Make disabling, previewing and undoing explicit parts of the remediation workflow.</p></article>
            <article><span>Observation</span><p>Changes had to fit enterprise operating practices.</p><b aria-hidden="true">→</b><span>Design implication</span><p>Carry selected devices, scheduling and change history through the end-to-end flow.</p></article>
          </div>
          <div class="research-conclusion">
            <p>The research reframed the project:</p>
            <blockquote>The goal was not to make policy complexity disappear. It was to reveal the right detail at the moment a decision depended on it.</blockquote>
          </div>
        </section>
      </main>
    </div>

    <nav class="return-nav shell" aria-label="Return to case study">
      <span>Continue the case study</span>
      <a href="/work/policy-optimization#research">Return to contextual research <span aria-hidden="true">→</span></a>
    </nav>
  </article>
</BaseLayout>

<style>
  .workshop-opening{margin-top:0}.workshop-intro{display:block;margin-bottom:42px}.workshop-intro h2{max-width:820px;font-size:clamp(2.5rem,5vw,5rem);line-height:1}.workshop-intro>p:last-child{max-width:680px;margin:30px 0 0;color:var(--muted);font-size:1.08rem}.workshop-gallery{display:grid;gap:14px}.workshop-day{margin:0;background:var(--paper-bright);border:1px solid var(--line);overflow:hidden}.workshop-day img{display:block;width:100%;height:auto;aspect-ratio:1718/426;object-fit:cover}.workshop-day figcaption{display:flex;align-items:baseline;gap:24px;padding:13px 18px;color:var(--muted);font-size:.7rem;line-height:1.45}.workshop-day figcaption span{flex:0 0 58px;color:var(--blue);font-size:.62rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase}.synthesis-process{margin-top:104px;padding-top:0}
