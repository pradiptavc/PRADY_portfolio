rgin-top:auto;font-size:1.35rem;line-height:1.1}.persona-grid p{color:var(--muted);font-size:.9rem}.before-after{display:grid;grid-template-columns:1fr 1fr;gap:1px;margin-top:65px;background:var(--line);border:1px solid var(--line)}.before-after article{padding:36px;background:var(--paper-bright)}.before-after article:last-child{background:#f7e8e2}.before-after span{font-size:.7rem;text-transform:uppercase;letter-spacing:.1em;color:#d45f4c}.before-after h3{margin:60px 0 28px;font-size:2rem}.before-after ul{padding-left:18px}.reflection-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin-top:65px;background:var(--line);border:1px solid var(--line)}.reflection-grid article{padding:30px;background:var(--paper-bright)}.reflection-grid span{color:#d45f4c;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em}.reflection-grid h3{margin:55px 0 25px;font-size:1.65rem}.reflection-grid p{color:var(--muted)}
