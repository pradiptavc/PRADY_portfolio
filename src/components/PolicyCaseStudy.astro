<script>
  const caseRoot = document.querySelector('[data-deep-case]');
  const chapterLinks = [...document.querySelectorAll<HTMLElement>('[data-chapter-link]')];
  const sections = [...document.querySelectorAll<HTMLElement>('.case-chapter')];
  if (caseRoot && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver((entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      chapterLinks.forEach((link) => link.toggleAttribute('aria-current', link.dataset.chapterLink === visible.target.id));
    }, { rootMargin: '-22% 0px -62%', threshold: [0, .2, .5] });
    sections.forEach((section) => observer.observe(section));
  }
  const dialog = document.querySelector<HTMLDialogElement>('[data-artifact-dialog]');
  const dialogImage = dialog?.querySelector('img');
  document.querySelectorAll<HTMLButtonElement>('[data-lightbox-src]').forEach((button) => button.addEventListener('click', () => {
    if (!dialog || !dialogImage) return;
    dialogImage.src = button.dataset.lightboxSrc || '';
    dialogImage.alt = button.dataset.lightboxAlt || '';
    dialog.showModal();
  }));
  dialog?.querySelector('[data-close-dialog]')?.addEventListener('click', () => dialog.close());
  dialog?.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
  document.querySelectorAll<HTMLElement>('[data-solution-gallery]').forEach((gallery) => {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-solution-tab]')];
    const panels = [...gallery.querySelectorAll<HTMLElement>('[data-solution-panel]')];
    const count = gallery.querySelector<HTMLElement>('[data-solution-count]');
    let activeIndex = 0;
    const activate = (nextIndex: number, focus = false) => {
      activeIndex = (nextIndex + tabs.length) % tabs.length;
      tabs.forEach((tab, index) => {
        const selected = index === activeIndex;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
      });
      panels.forEach((panel, index) => { panel.hidden = index !== activeIndex; });
      if (count) count.textContent = `${String(activeIndex + 1).padStart(2, '0')} / ${String(tabs.length).padStart(2, '0')}`;
      if (focus) tabs[activeIndex]?.focus();
    };
    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => activate(index));
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        activate(index + (event.key === 'ArrowRight' ? 1 : -1), true);
      });
    });
    gallery.querySelector('[data-solution-prev]')?.addEventListener('click', () => activate(activeIndex - 1));
    gallery.querySelector('[data-solution-next]')?.addEventListener('click', () => activate(activeIndex + 1));
  });
  document.querySelector<HTMLButtonElement>('[data-demo-player] button')?.addEventListener('click', (event) => {
    const player = (event.currentTarget as HTMLElement).closest<HTMLElement>('[data-demo-player]');
    if (!player) return;
    const iframe = document.createElement('iframe');
    iframe.src = 'https://www.youtube-nocookie.com/embed/iHbN9OdAfPw?autoplay=1&rel=0';
    iframe.title = 'Policy Analyzer and Optimizer three-minute product demo';
    iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
    iframe.allowFullscreen = true;
    player.replaceChildren(iframe);
  });
</script>

