---
interface Chapter { id: string; label: string }
interface Props {
  chapters: Chapter[];
  prototypeUrl: string;
  prototypeTitle: string;
  prototypeReviewed: boolean;
  disclosure: string;
}

const { chapters, disclosure } = Astro.props;

const decisions = [
  { observation: 'Operators monitored many tools and often discovered policy problems only after risk had accumulated.', insight: 'A list of anomalies was not enough; people needed an at-a-glance model of policy health.', decision: 'Lead with a health summary and make every category traceable to supporting rules.', result: 'The dashboard became an orientation layer, not an endpoint.' },
  { observation: 'Removing a rule could interrupt legitimate traffic, so even obvious cleanup carried operational anxiety.', insight: 'Trust depended on inspectable evidence and an explicit escape route.', decision: 'Show hit history, action, zones, networks, ports and VLAN before presenting remediation.', result: 'Operators could verify the recommendation and choose a reversible disable path.' },
  { observation: 'Policy work crossed devices, teams and maintenance windows.', insight: 'A recommendation without governance would not fit enterprise operations.', decision: 'Keep selection, review, scheduling, application and change history as distinct states.', result: 'Remediation became deliberate, auditable and easier to coordinate.' },
];

const prototypeSteps = [
  ['01', 'Select and analyse', 'Choose policies from the Access Control list and make analysis status visible.'],
  ['02', 'Orient with policy health', 'Summarise rules, anomalies, disabled and expired states before asking for action.'],
  ['03', 'Inspect the evidence', 'Group fully shadowed and redundant rules while preserving the fields an expert needs to verify them.'],
  ['04', 'Choose a safe response', 'Offer disable or delete deliberately, making the lower-risk, reversible path clear.'],
  ['05', 'Review before applying', 'Mark proposed changes, allow undo, then apply remediation to the selected devices.'],
  ['06', 'Keep an audit trail', 'Support scheduling and change history so optimization fits operational governance.'],
];

const solutionScreens = [
  { id: 'fully-shadowed', label: 'Fully shadowed', title: 'Reveal the rule that makes other rules unreachable.', image: '/images/policy-case/solution-fully-shadowed.webp', width: 1800, height: 1591, alt: 'Fully Shadowed Rules screen grouping a dominant rule with the rules it shadows and showing hit count, last hit, action, zones, networks, ports and VLAN evidence', meaning: 'A fully shadowed rule can never be evaluated because an earlier rule already matches the same traffic. The design groups each observation around the rule creating the shadow, then exposes the affected rules and the evidence needed to verify the relationship.', action: 'Administrators can expand each observation, compare rule evidence, and choose a reversible disable or deliberate delete path—individually or in bulk.' },
  { id: 'mergeable', label: 'Mergeable', title: 'Turn several equivalent rules into one understandable rule.', image: '/images/policy-case/solution-mergeable.webp', width: 1800, height: 1606, alt: 'Mergeable Rules screen previewing one combined rule above the original rules and showing marked remediation with undo', meaning: 'Rules with compatible criteria can be consolidated without changing intent. The screen previews the proposed merged rule above its source rules so administrators can understand exactly what will be combined.', action: 'The change is marked rather than silently committed, with undo and final apply controls preserving review and governance.' },
  { id: 'expired', label: 'Expired', title: 'Separate temporary access that ended from policy that still matters.', image: '/images/policy-case/solution-expired.webp', width: 1800, height: 1591, alt: 'Expired Rules screen listing expiration date, hit count, last hit and associated time range for each rule', meaning: 'Expired rules were created for a time-bound purpose but remain in the policy after that purpose has ended. Expiry, hit history and time-range evidence make the reason for cleanup explicit.', action: 'Administrators can verify recency before disabling or deleting expired rules in a controlled batch.' },
  { id: 'dead', label: 'Dead rules', title: 'Find rules that stayed in the policy long after their usefulness left.', image: '/images/policy-case/solution-dead.webp', width: 1800, height: 1591, alt: 'Dead Rules screen showing hit count, last hit, action, first hit time and last hit time with search and filter controls', meaning: 'Dead rules have no meaningful recent use or no longer map to a valid operational need. Search, action, device and time filters help distinguish genuinely obsolete rules from infrequently used ones.', action: 'Teams can investigate usage history first, then disable or delete with evidence instead of relying on memory.' },
  { id: 'aces', label: 'ACEs per rule', title: 'Expose rules whose complexity quietly taxes performance.', image: '/images/policy-case/solution-aces-per-rule.webp', width: 1800, height: 1606, alt: 'ACEs per Rule screen comparing access control entry counts with horizontal magnitude bars across policy rules', meaning: 'A very high number of access control entries can make a rule difficult to manage and expensive for the firewall to evaluate. Relative bars make outliers visible without requiring administrators to compare long numbers manually.', action: 'Administrators can locate the heaviest rules, inspect their structure and prioritise simplification where it has the greatest operational value.' },
  { id: 'hit-rules', label: 'Hit rules', title: 'Show what the firewall actually uses before anyone cleans house.', image: '/images/policy-case/solution-hit-rules.webp', width: 1800, height: 1606, alt: 'Hit Rules screen listing rule hit counts, last hit, action, first hit time and last hit time with device and date filters', meaning: 'Hit history reveals which rules are actively carrying traffic and how recently they were used. That context prevents “unused-looking” rules from being treated as safe cleanup candidates.', action: 'Time, device and action filters help teams protect high-value rules and focus remediation on evidence-backed candidates.' },
];

const adoptionHeadlineMetrics = [
  ['3,782+', 'New feature licenses'],
  ['50%', 'Customers upgraded'],
  ['6%', 'New customers'],
  ['38%', 'Reduction in TAC cases'],
];

const adoptionReleases = ['6.5', '6.6', '6.7', '7.0', '7.1', '7.2', '7.3', '7.4', '7.5 stable', '7.6'];
const adoptionRows = [
  { device: 'FTD 1000', before: ['7%', '14%', '4%', '1%', '2%', '1%', '0.5%', '—', '—', '—'], after: ['1% (−6)', '3% (−11)', '1% (−3)', '2% (+1)', '4% (+2)', '1%', '1.5% (+1)', '1% (+1)', '15% (+15)', '—'] },
  { device: 'FTD 2000', before: ['4%', '7%', '2%', '3%', '—', '—', '—', '—', '—', '—'], after: ['2% (−2)', '1% (−6)', '0% (−2)', '4% (+1)', '—', '—', '—', '1% (+1)', '8% (+8)', '—'] },
  { device: 'FTD 3000', before: ['2%', '5%', '18%', '6%', '1%', '1%', '2%', '2.5%', '1%', '0.5%'], after: ['0% (−2)', '1% (−4)', '4% (−14)', '7.5% (+1.5)', '1%', '1%', '4% (+2)', '5% (+2.5)', '13% (+12)', '0.5%'] },
  { device: 'FTD 5000', before: ['—', '—', '—', '—', '3%', '1%', '1%', '1.5%', '3%', '1%'], after: ['—', '—', '—', '—', '3%', '1%', '1%', '1.5%', '3%', '1%'] },
  { device: 'FTD 9000', before: ['—', '—', '—', '—', '1%', '1%', '0.5%', '1%', '1%', '0.5%'], after: ['—', '—', '—', '—', '1%', '1%', '0.5%', '1%', '1%', '0.5%'] },
];

const releaseShift = [
  { release: 'Legacy 6.5–6.7', before: 63, after: 13, delta: '−50 pts', tone: 'legacy' },
  { release: '7.0', before: 10, after: 13.5, delta: '+3.5 pts', tone: 'current' },
  { release: '7.1', before: 7, after: 9, delta: '+2 pts', tone: 'current' },
  { release: '7.2', before: 4, after: 4, delta: 'No change', tone: 'current' },
  { release: '7.3', before: 4, after: 7, delta: '+3 pts', tone: 'current' },
  { release: '7.4', before: 5, after: 9, delta: '+4 pts', tone: 'current' },
  { release: '7.5 stable', before: 5, after: 40, delta: '+35 pts', tone: 'stable' },
  { release: '7.6', before: 2, after: 2, delta: 'No change', tone: 'current' },
];
---

<div class="deep-case" data-deep-case>
  <nav class="chapter-nav" aria-label="Case study chapters">
    <p>Inside this case</p>
    <ol>{chapters.map((chapter) => <li><a href={`#${chapter.id}`} data-chapter-link={chapter.id}>{chapter.label}</a></li>)}</ol>
  </nav>

  <details class="chapter-menu">
    <summary>Explore this case study <span aria-hidden="true">＋</span></summary>
    <nav aria-label="Case study chapters on mobile"><ol>{chapters.map((chapter) => <li><a href={`#${chapter.id}`}>{chapter.label}</a></li>)}</ol></nav>
  </details>

  <main class="case-narrative">
    <section id="summary" class="case-chapter chapter-lead">
      <p class="chapter-index">01 / Executive summary</p>
      <h2>Policy cleanup was a <em>decision-confidence</em> problem.</h2>
      <div class="lead-grid"><p>Enterprise firewall policies accumulate rules, exceptions and workarounds across years. Teams know that redundant or shadowed rules create risk, but a mistaken cleanup can interrupt critical traffic. The opportunity was to help experts understand what was wrong, verify why it mattered and act without surrendering control.</p><p class="lead-note">The design challenge was to turn technical detection into a trustworthy sequence of orientation, evidence, judgment and governed action.</p></div>
      <aside class="demo-feature" aria-labelledby="demo-feature-title">
        <div class="demo-copy"><span>3-minute product demo</span><h3 id="demo-feature-title">From policy uncertainty to controlled action.</h3><p>A concise walkthrough of the optimization experience—from identifying policy risk to taking a deliberate, evidence-led action.</p></div>
        <div class="demo-player" data-demo-player>
          <button type="button" aria-label="Play the three-minute Policy Analyzer and Optimizer demo">
            <img src="https://i.ytimg.com/vi/iHbN9OdAfPw/maxresdefault.jpg" alt="Video preview for the Policy Analyzer and Optimizer demonstration" width="1280" height="720" loading="lazy">
            <span class="demo-play" aria-hidden="true">▶</span>
            <span class="demo-duration">03:00 · Play demo</span>
          </button>
        </div>
      </aside>
      <a class="publication-strip" href="https://www.tdcommons.org/dpubs_series/2761/" target="_blank" rel="noreferrer">
        <span>Published : 1024551-US.01</span><b aria-hidden="true">↗</b>
      </a>
    </section>

    <section id="problem" class="case-chapter problem-chapter">
      <p class="chapter-index">02 / The problem</p>
      <h2>Correct insight. Missing confidence.</h2>
      <p class="problem-summary">Existing experiences surfaced findings without sufficiently explaining their consequence. Operators had to connect evidence across screens, infer blast radius and decide whether a recommendation was safe.</p>
      <ul class="tension-list"><li><span>Signal</span>Find the small number of meaningful problems inside a large rule base.</li><li><span>Evidence</span>See why a rule was classified as anomalous.</li><li><span>Control</span>Choose an action proportional to operational risk.</li><li><span>Governance</span>Coordinate changes across devices, teams and maintenance windows.</li></ul>
    </section>

    <section id="role" class="case-chapter dark-chapter">
      <p class="chapter-index">03 / Role & leadership</p><h2>Leading the experience from ambiguity to a shippable system.</h2>
      <div class="role-grid"><p>I led problem framing, experience strategy and end-to-end interaction design, partnering with product managers, researchers, engineering and cross-functional stakeholders. My responsibility was not only to design the screens, but to align the team around the right definition of trust.</p><dl><div><dt>Owned</dt><dd>End-to-end solution and interaction model</dd></div><div><dt>Core partnership</dt><dd>Product, research and engineering</dd></div><div><dt>Leadership move</dt><dd>Separated detection from decision support</dd></div><div><dt>Delivery approach</dt><dd>Phased value without waiting for a platform rewrite</dd></div></dl></div>
    </section>

    <section id="people" class="case-chapter">
      <p class="chapter-index">04 / People</p><h2>Three roles. Different responsibilities. One shared need for confidence.</h2>
      <div class="persona-grid"><article><span>Primary</span><strong>NIK</strong><h3>Network Administrator</h3><p>Continuously monitors tools and network data, prioritising issues before customers notice disruption or threats create damage.</p></article><article><span>Secondary</span><strong>KIT</strong><h3>IT Administrator</h3><p>Needs policy work to remain manageable across systems, devices and operational schedules.</p></article><article><span>Secondary</span><strong>SAM</strong><h3>Security Analyst</h3><p>Needs enough evidence to distinguish genuine exposure from noisy technical findings.</p></article></div>
      <article class="nik-profile" aria-labelledby="nik-profile-title">
        <header class="nik-profile-head">
          <img class="nik-mark" src="/images/policy-case/nik-profile.png" alt="Illustrated profile portrait of Nik, the Network Administrator persona" width="114" height="139" loading="lazy">
          <div><span>Primary persona</span><h3 id="nik-profile-title">NIK</h3><p>Network Administrator</p></div>
          <blockquote>“What’s up, what’s down, and how fast is my data flowing?”</blockquote>
        </header>
        <div class="nik-knowledge" aria-label="Nik’s knowledge levels">
          <span>Security knowledge <b>Medium</b></span>
          <span>Triage knowledge <b>Medium</b></span>
          <span>Other-tool knowledge <b>Medium</b></span>
        </div>
        <div class="nik-details">
          <section><h4>Goals & responsibilities</h4><ul><li>Keep the network running 24/7</li><li>Know what is running on the network</li><li>Plan network and security updates</li><li>Make updates and repairs</li><li>Coordinate with the ISP</li><li>Collaborate with Security and InfoSec</li><li>Respond to network issues immediately</li><li>Ensure compliance requirements are met</li><li>Report performance, bandwidth and interfaces</li><li>Secure the network</li><li>Harden network devices, servers and firewalls</li></ul></section>
          <section><h4>Challenges</h4><ul><li>Maintaining high performance while mitigating risk</li><li>Managing a dynamic, continuously changing network</li><li>No time to monitor the network actively</li><li>Poor integration for collecting and analysing events and logs</li><li>Complicated configuration</li><li>Shrinking maintenance windows</li><li>Traffic drops during deployment</li><li>Misconfigured assets such as servers</li></ul></section>
          <section><h4>Needs</h4><ul><li>Bandwidth and performance data</li><li>Alerting</li><li>Customisable dashboards</li><li>Relationship maps</li><li>Simple interfaces for new and junior staff</li></ul></section>
          <section><h4>Skills & knowledge</h4><dl><div><dt>Security</dt><dd>Medium</dd></div><div><dt>Triage</dt><dd>Medium</dd></div><div><dt>Other tools</dt><dd>Medium</dd></div></dl><p>Constantly monitors tools and network data, deciding what needs attention before disruption reaches customers.</p></section>
        </div>
      </article>
    </section>

    <section id="research" class="case-chapter artifact-chapter">
      <div class="chapter-heading"><div><p class="chapter-index">05 / Contextual research</p><h2>Study the work before simplifying the interface.</h2></div><p>Contextual inquiry, dashboard review, field evidence and research questions made the operating environment visible: monitoring is continuous, evidence is fragmented and cleanup competes with urgent work.</p></div>
      <a class="research-detail-link" href="/work/policy-optimization/research-02-1"><span><small>Detailed research narrative</small><strong>Explore Contextual Research</strong></span><b aria-hidden="true">→</b></a>
      <div class="research-questions">
        <header><p>High-value research questions</p><span>The broader interview guide converged around four decisions the product needed to support.</span></header>
        <ol>
          <li><span>Awareness</span><p>How do teams recognise which policy problem needs attention first?</p></li>
          <li><span>Understanding</span><p>What context helps them interpret an anomaly and its operational consequence?</p></li>
          <li><span>Confidence</span><p>Which evidence makes disabling, deleting or retaining a rule feel safe?</p></li>
          <li><span>Governance</span><p>How should remediation fit devices, approvals, deployments and maintenance windows?</p></li>
        </ol>
      </div>
    </section>

    <section id="synthesis" class="case-chapter"><p class="chapter-index">06 / Synthesis</p><h2>Raw observations became a system of design decisions.</h2><div class="decision-stack">{decisions.map((item, i) => <article><span>{String(i + 1).padStart(2, '0')}</span><dl><div><dt>Observation</dt><dd>{item.observation}</dd></div><div><dt>Insight</dt><dd>{item.insight}</dd></div><div><dt>Design decision</dt><dd>{item.decision}</dd></div><div><dt>Resulting behaviour</dt><dd>{item.result}</dd></div></dl></article>)}</div></section>

    <section id="journey" class="case-chapter split-chapter"><div><p class="chapter-index">07 / Current journey</p><h2>The old journey made experts assemble the story themselves.</h2></div><div><p>Current-state mapping exposed a sequence of hidden costs: finding the right policy, waiting without clear status, interpreting anomaly terminology, switching context to verify a rule, and acting without a clear preview of consequence.</p><blockquote>Every context switch transferred cognitive and operational risk back to the operator.</blockquote></div></section>

    <section id="landscape" class="case-chapter compact-chapter"><p class="chapter-index">08 / Competitive landscape</p><h2>Feature comparison revealed a gap between <em>finding</em> and <em>resolving</em>.</h2><p>The comparative matrix on board 02-3 tested detection coverage, explanation, prioritisation, remediation controls and governance. The strategic opening was not another anomaly list; it was a connected decision workflow.</p><div class="continuum"><span>Detect</span><i></i><span>Explain</span><i></i><span>Verify</span><i></i><span>Remediate</span><i></i><span>Audit</span></div></section>

    <section id="principles" class="case-chapter"><p class="chapter-index">09 / Design principles</p><h2>Four principles kept the solution honest.</h2><ol class="principle-list"><li><b>01</b><span><strong>Start with consequence</strong>Explain why a finding matters before exposing every technical category.</span></li><li><b>02</b><span><strong>Make evidence inspectable</strong>Summarise for orientation, then preserve expert-level detail on demand.</span></li><li><b>03</b><span><strong>Prefer reversible action</strong>Make disable, preview and undo first-class parts of remediation.</span></li><li><b>04</b><span><strong>Design for governance</strong>Treat scheduling, devices and change history as part of the experience.</span></li></ol></section>

    <section id="flows" class="case-chapter"><p class="chapter-index">10 / Workflow exploration</p><h2>A phased architecture connected analysis to action.</h2><p class="measure">The new flow separated policy selection, analysis, health orientation, anomaly investigation and remediation. Branches for disabling and deleting fully redundant rules made the risk difference explicit rather than burying it inside a generic action.</p><div class="flow-map" aria-label="Policy optimization workflow"><span>Select policy</span><b>→</b><span>Analyse</span><b>→</b><span>Review health</span><b>→</b><span>Inspect evidence</span><b>→</b><span>Choose action</span><b>→</b><span>Apply & audit</span></div></section>

    <section id="visualization" class="case-chapter policy-health-chapter">
      <div class="chapter-heading">
        <div><p class="chapter-index">11 / Policy-health visualization</p><h2>A thousand rules. One place to see which ones were quietly causing trouble.</h2></div>
        <p>The final summary created an orientation layer before investigation: establish the scale, reveal the health distribution, compare anomaly categories and offer direct paths into the evidence.</p>
      </div>
      <figure class="policy-dashboard">
        <div class="policy-dashboard-frame"><img src="/images/policy-case/summary-dashboard-original.webp" alt="Policy Analyzer and Optimizer summary dashboard showing totals, rule-health distribution, anomaly categories, usage and direct optimization paths" width="1800" height="1500" loading="lazy"></div>
        <figcaption><span>Final product artifact</span><p>The summary connects policy health, anomaly scale, rule usage and object usage without collapsing them into one reassuring—but unhelpful—score.</p></figcaption>
      </figure>
      <div class="policy-health-logic" aria-label="Policy health visualization logic">
        <article><span>01</span><strong>Orient</strong><p>See the size and overall condition of the policy estate.</p></article>
        <article><span>02</span><strong>Explain</strong><p>Understand which anomaly categories deserve attention.</p></article>
        <article><span>03</span><strong>Investigate</strong><p>Move directly from a signal to the supporting rules.</p></article>
        <aside>Because “467 anomalies” is useful. “Good luck finding them” is not.</aside>
      </div>
    </section>

    <section id="solution" class="case-chapter solution-chapter">
      <p class="chapter-index">12 / Final solution</p>
      <h2>From uncertainty to controlled action in six moves.</h2>
      <ol class="prototype-steps">{prototypeSteps.map(([index, title, copy]) => <li><span>{index}</span><div><h3>{title}</h3><p>{copy}</p></div></li>)}</ol>
      <div class="solution-gallery" data-solution-gallery>
        <header class="solution-gallery-head"><div><span>Final product artifacts</span><strong data-solution-count>01 / 06</strong></div><nav aria-label="Browse final solution screens"><button type="button" data-solution-prev aria-label="Previous solution screen">←</button><button type="button" data-solution-next aria-label="Next solution screen">→</button></nav></header>
        <div class="solution-tabs" role="tablist" aria-label="Final solution screens">
          {solutionScreens.map((screen, index) => <button type="button" role="tab" id={`solution-tab-${screen.id}`} aria-controls={`solution-panel-${screen.id}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? '0' : '-1'} data-solution-tab={index}>{screen.label}</button>)}
        </div>
        <div class="solution-panels">
          {solutionScreens.map((screen, index) => (
            <section id={`solution-panel-${screen.id}`} role="tabpanel" aria-labelledby={`solution-tab-${screen.id}`} hidden={index !== 0} data-solution-panel={index}>
              <button class="solution-screen" type="button" data-lightbox-src={screen.image} data-lightbox-alt={screen.alt} aria-label={`Enlarge ${screen.label} solution screen`}><img src={screen.image} alt={screen.alt} width={screen.width} height={screen.height} loading="lazy"></button>
              <div class="solution-explanation">
                <div><span>What it means</span><h3>{screen.title}</h3><p>{screen.meaning}</p></div>
                <div><span>What the solution enables</span><p>{screen.action}</p><small>Click the screen to inspect the original artifact.</small></div>
              </div>
            </section>
          ))}
        </div>
      </div>
    </section>

    <section id="prototype" class="case-chapter prototype-chapter">
      <p class="chapter-index">13 / Clickable prototype</p>
      <h2>See the decisions in motion.</h2>
      <p class="prototype-intro">Walk through policy selection, analysis, evidence, remediation and change history in the original interaction sequence.</p>
      <aside class="prototype-invitation">
        <div><span>Interactive Figma prototype</span><strong>No cinematic trailer. Just the real decisions, one click at a time.</strong><p>Start at login and follow the complete path from policy uncertainty to reviewed, controlled action.</p></div>
        <a class="button prototype-link" href="/work/policy-optimization/prototype" target="_blank" rel="noreferrer">Open prototype in Figma <span aria-hidden="true">↗</span></a>
      </aside>
    </section>

    <section id="evidence" class="case-chapter adoption-chapter">
      <p class="chapter-index">14 / Before & after</p>
      <div class="adoption-heading"><div><h2>The product shipped. Customers did not leave it on the shelf.</h2><p>After Policy Analyzer &amp; Optimizer was released, adoption moved decisively toward newer FMC releases—turning a better remediation experience into measurable platform momentum.</p></div><aside><span>The clearest signal</span><strong>6.5–6.7</strong><b>63% → 13%</b><small>A 50-point move away from legacy releases.</small></aside></div>
      <div class="adoption-metrics" aria-label="Policy Analyzer and Optimizer adoption metrics">{adoptionHeadlineMetrics.map(([value, label]) => <article><strong>{value}</strong><span>{label}</span></article>)}</div>
      <div class="release-shift" aria-labelledby="release-shift-title">
        <header><div><span>Release adoption</span><h3 id="release-shift-title">The upgrade story, release by release.</h3></div><p>Grey shows the starting mix. Colour shows where customers landed after launch. The punchline is pleasantly unglamorous: they upgraded.</p></header>
        <div class="shift-list">{releaseShift.map((item) => <article class={`shift-row ${item.tone}`}><strong>{item.release}</strong><div class="shift-bars"><span class="before-bar" style={`--value:${item.before}`}><i>Before</i><b>{item.before}%</b></span><span class="after-bar" style={`--value:${item.after}`}><i>After</i><b>{item.after}%</b></span></div><em>{item.delta}</em></article>)}</div>
      </div>
      <details class="adoption-matrix">
        <summary><span><small>Evidence by device family</small><strong>Explore the complete adoption matrix</strong></span><b aria-hidden="true">＋</b></summary>
        <div class="matrix-scroll" tabindex="0" aria-label="Scrollable device and FMC release adoption matrix">
          <table>
            <thead><tr><th scope="col">Device</th>{adoptionReleases.map((release) => <th scope="col">{release}</th>)}</tr></thead>
            <tbody>{adoptionRows.map((row) => <><tr class="before-row"><th scope="row" rowspan="2"><strong>{row.device}</strong><span>Before / after</span></th>{row.before.map((value) => <td>{value}</td>)}</tr><tr class="after-row">{row.after.map((value) => <td>{value}</td>)}</tr></>)}</tbody>
          </table>
        </div>
        <p>Percentages and point changes reproduce the grouped Adoption Metrics layer in board 02. Dashes indicate no value shown in the source.</p>
      </details>
      <div class="adoption-conclusion"><span>Before</span><p>Policy findings existed, but legacy estates, fragmented evidence and manual remediation kept progress cautious.</p><b aria-hidden="true">→</b><span>After</span><p>Explainable policy health, inspectable evidence and controlled action gave customers a reason—and enough confidence—to move forward.</p></div>
    </section>

    <section id="impact" class="case-chapter recognition-chapter">
      <p class="chapter-index">15 / Recognition &amp; impact</p>
      <div class="recognition-heading"><div><h2>The idea earned more than roadmap space. It needed shelf space.</h2><p>Rule Heartbeat was recognised as a 2020 Innovate Everywhere Challenge winner—placing among the top three of more than 400 innovations.</p></div><span>Proof, not confetti.</span></div>
      <div class="recognition-story">
        <figure class="trophy-feature">
          <div><img src="/images/innovation-trophy.webp" alt="Cisco 2020 Innovate Everywhere Challenge winner trophy awarded to Rule Heartbeat" width="900" height="1200" loading="lazy"></div>
          <figcaption><span>01 / The award</span><strong>2020 Winner · Rule Heartbeat</strong><p>A physical reminder that making policy health understandable was not merely a design improvement—it was recognised as an innovation with customer and business value.</p></figcaption>
        </figure>
        <div class="recognition-proof">
          <blockquote>“Your commitment to innovation and entrepreneurship remains constant and stronger than ever.”</blockquote>
          <div class="letter-card">
            <button type="button" data-lightbox-src="/images/chuck-robbins-letter.webp" data-lightbox-alt="Recognition letter from Cisco Chairman and CEO Chuck Robbins congratulating Pradipta and the Rule Heartbeat team"><img src="/images/chuck-robbins-letter.webp" alt="Preview of recognition letter from Cisco Chairman and CEO Chuck Robbins" width="1400" height="1256" loading="lazy"><span>Read the letter <b aria-hidden="true">↗</b></span></button>
            <div><span>02 / Executive recognition</span><strong>A note from Chuck Robbins</strong><p>Cisco’s Chairman and CEO recognised the team’s focus, adaptability and collaboration—and the potential to positively affect customers preparing for the future.</p></div>
          </div>
          <aside><strong>Recognition is lovely.</strong><p>Recognition backed by adoption, fewer TAC cases and customers moving to newer releases? That is the part the trophy cannot fit on its plaque.</p></aside>
        </div>
      </div>
    </section>

    <section id="reflection" class="case-chapter"><p class="chapter-index">16 / Reflection</p><h2>What I learned, wish and wonder.</h2><div class="reflection-grid"><article><span>I learned</span><h3>Lead difficult work with active listening.</h3><p>Let people express their position, summarise to demonstrate understanding, stay objective and steer the conversation toward what the team can do next.</p></article><article><span>I wish</span><h3>We had more room to test between sprints.</h3><p>More development capacity across platforms, earlier usability testing for edge cases, and tighter alignment between sales feedback and the roadmap would have accelerated learning.</p></article><article><span>I wonder</span><h3>Can policy management become self-tuning?</h3><p>Traffic-aware suggestions, AI-assisted review and zero-trust management point toward a future where automation earns trust through evidence rather than replacing judgment.</p></article></div><aside class="disclosure-note"><strong>Publication note</strong><p>{disclosure}</p></aside></section>
  </main>
</div>

