  @media(max-width:760px){.assign-journey{width:calc(100% - 32px)}.assign-hero{padding-bottom:70px}.assign-hero>a{margin-bottom:65px}.assign-hero>div,.step-grid{grid-template-columns:1fr}.assign-section{padding:75px 0}.dark-section{margin-inline:-16px;padding-inline:16px}.evidence-list article{grid-template-columns:36px 1fr}.evidence-list p{grid-column:2}.artifact-section figcaption{grid-template-columns:1fr}.handoff-flow{grid-template-columns:1fr}.handoff-flow i{justify-self:center;transform:rotate(90deg)}.journey-footer{align-items:flex-start;flex-direction:column}}
</style>
