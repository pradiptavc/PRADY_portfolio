---
const steps = [
  ['Find related signals','Move from the AIOps summary into the complete insight list instead of resolving cards one at a time.'],
  ['Select with context','Choose the related insights while severity, priority, source, affected device and time remain visible.'],
  ['Assign together','Use “Resolve for me” to create a controlled group of agent jobs from the selected evidence.'],
  ['Confirm the handoff','A toast confirms how many jobs were assigned and offers a direct route to review them.'],
  ['Review in Workforce','The jobs summary carries ownership, priority, source, date and status into operational follow-through.'],
];

const stateRules = [
  ['New or in progress','Pause job · Unassign agent','Work can still be interrupted or reassigned.'],
  ['Resolved','Download report · Share report','Completed work becomes evidence to retrieve and communicate.'],
  ['Mixed selection','Pause and unassign—with a warning','Eligible jobs change; completed jobs remain complete. No time travel, even for AI.'],
];
---

<div class="bulk-journey">
  <header class="bulk-hero">
    <a href="/work/agenticops#agentic-trust">← Back to Trust journey</a>
    <p>Journey 03 · Bulk-assign insights</p>
    <h1>Scale the assignment—not the ambiguity.</h1>
    <div>
      <p>Operators can group related insights into agent work without losing the context that made each signal important. Once assigned, bulk actions adapt to job state instead of offering one dangerously cheerful button for everything.</p>
      <aside>Phase 02 · AgenticOps<br/><b>Many signals. One controlled handoff.</b></aside>
    </div>
  </header>

  <nav aria-label="Bulk-assign journey chapters"><a href="#flow">Assignment flow</a><a href="#states">State-aware control</a><a href="#artifact">Figma artifact</a><a href="#principle">Design principle</a></nav>

  <section id="flow" class="bulk-section">
    <p class="index">01 / Assignment flow</p>
    <h2>Five moves from a cluster of signals to reviewable agent work.</h2>
    <div class="step-grid">{steps.map(([title,copy],index) => <article><span>{String(index+1).padStart(2,'0')}</span><h3>{title}</h3><p>{copy}</p></article>)}</div>
  </section>

  <section id="states" class="bulk-section dark-section">
    <p class="index">02 / State-aware control</p>
    <h2>Bulk does not mean blunt.</h2>
    <p class="lead">The available action changes with the selected jobs. This keeps the shortcut fast while preserving the truth of each job’s lifecycle.</p>
    <div class="state-grid">{stateRules.map(([state,action,reason],index) => <article><span>{String(index+1).padStart(2,'0')}</span><p>{state}</p><h3>{action}</h3><small>{reason}</small></article>)}</div>
    <aside>One selection can contain several realities. The interface should notice before the operator has to.</aside>
  </section>

  <section id="artifact" class="bulk-section artifact-section">
    <p class="index">03 / Complete Figma artifact</p>
    <h2>The complete Bulk Assign journey, preserved exactly as designed.</h2>
    <p class="lead">Scroll from the AIOps summary through multi-select assignment, confirmation and Agent Workforce—then compare how bulk actions respond to new, active, resolved and mixed job states.</p>
    <figure>
      <img src="/images/agentic-journeys/agentic-bulk-assign-flow-2025-5.png" alt="Complete AgenticOps bulk assignment journey from AIOps insights to state-aware bulk controls in Agent Workforce" loading="eager" />
      <figcaption><span>2025-5 · Journey artifact</span><p>Exact export from the supplied Figma artboard. The Cisco interface screens remain unchanged.</p></figcaption>
    </figure>
  </section>

  <section id="principle" class="bulk-section principle-section">
    <p class="index">04 / Design principle</p>
    <h2>Efficiency earns trust when the system explains what will—and will not—change.</h2>
    <div class="principle-flow"><article><span>Select</span><b>Related insights keep their operational evidence</b></article><i>→</i><article><span>Assign</span><b>The handoff confirms scope and provides a review path</b></article><i>→</i><article><span>Control</span><b>Actions respect each job’s current state</b></article></div>
    <div class="journey-footer"><a href="/work/agenticops/journeys/assign-from-insights">← Previous · Assign from Insights</a><a href="/work/agenticops#agentic-trust">All journeys</a><a href="/work/agenticops/journeys/manage-agent-job">Next · Manage agent job →</a></div>
  </section>
</div>

<style>
  .bulk-journey{width:min(1180px,calc(100% - 48px));margin:0 auto;padding-bottom:110px}.bulk-hero{padding:44px 0 100px}.bulk-hero>a{display:inline-block;margin-bottom:95px;color:var(--muted);font-size:.75rem;text-decoration:none}.bulk-hero>p,.index{color:#486fd5;font-size:.66rem;font-weight:600;letter-spacing:.11em;text-transform:uppercase}.bulk-hero h1{max-width:1100px;margin:28px 0 55px;font-size:clamp(3.5rem,7vw,7rem);line-height:.9;letter-spacing:-.075em}.bulk-hero>div{display:grid;grid-template-columns:1.2fr .8fr;gap:60px}.bulk-hero>div>p{max-width:720px;margin:0;color:var(--muted);font-size:1.08rem}.bulk-hero aside{padding:20px 24px;border-left:3px solid #755cff;background:#ebe7ff;color:var(--muted);font-size:.68rem}.bulk-hero aside b{display:block;margin-top:8px;color:var(--ink);font:600 .9rem 'Manrope'}.bulk-journey>nav{position:sticky;top:0;z-index:10;display:flex;gap:8px;padding:11px 0;background:color-mix(in srgb,var(--paper) 94%,transparent);backdrop-filter:blur(12px);border-block:1px solid var(--line);overflow:auto}.bulk-journey>nav a{padding:8px 11px;color:var(--muted);font-size:.68rem;white-space:nowrap;text-decoration:none}.bulk-section{scroll-margin-top:70px;padding:100px 0;border-bottom:1px solid var(--line)}.bulk-section h2{max-width:1020px;margin:22px 0 40px;font-size:clamp(2.7rem,5vw,5rem)}.lead{max-width:860px;color:var(--muted);font-size:.95rem}.step-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:9px;margin-top:55px}.step-grid article{min-height:250px;padding:22px;display:flex;flex-direction:column;background:var(--paper-bright);border-top:3px solid #755cff}.step-grid span{color:#654be0;font-size:.64rem}.step-grid h3{margin:32px 0 16px;font-size:1.08rem}.step-grid p{margin:auto 0 0;color:var(--muted);font-size:.7rem}.dark-section{margin-inline:calc((100vw - min(1180px,calc(100vw - 48px)))/-2);padding-inline:max(24px,calc((100vw - 1180px)/2));background:#111827;color:white;border:0}.dark-section .index{color:#a89aff}.dark-section .lead{color:#aeb8ca}.state-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:55px}.state-grid article{min-height:250px;padding:25px;background:#1c2638;border-top:3px solid #8f7aff}.state-grid span{color:#a89aff;font-size:.63rem}.state-grid article>p{margin:30px 0 8px;color:#aeb8ca;font-size:.7rem;text-transform:uppercase;letter-spacing:.06em}.state-grid h3{margin:0 0 30px;font-size:1.3rem}.state-grid small{display:block;color:#aeb8ca;font-size:.72rem;line-height:1.5}.dark-section>aside{margin-top:10px;padding:17px 20px;background:#8f7aff;color:#111827;font:600 .8rem 'Manrope'}.artifact-section figure{margin:60px 0 0;background:#444}.artifact-section img{width:100%;height:auto;display:block}.artifact-section figcaption{display:grid;grid-template-columns:200px 1fr;gap:25px;padding:20px;background:#17243c;color:white}.artifact-section figcaption span{color:#a89aff;font-size:.64rem;text-transform:uppercase}.artifact-section figcaption p{margin:0;color:#b5c1d2;font-size:.72rem}.principle-section{border-bottom:0}.principle-flow{display:grid;grid-template-columns:1fr auto 1fr auto 1fr;gap:12px;align-items:stretch}.principle-flow article{padding:24px;background:#ebe7ff}.principle-flow span{display:block;margin-bottom:35px;color:#654be0;font-size:.63rem;text-transform:uppercase}.principle-flow b{font:600 .95rem/1.4 'Manrope'}.principle-flow i{align-self:center;color:#755cff;font-style:normal}.journey-footer{display:flex;justify-content:space-between;gap:20px;margin-top:65px;padding-top:22px;border-top:1px solid var(--line)}.journey-footer a{color:var(--muted);font-size:.72rem;text-decoration:none}.journey-footer a:hover{color:var(--ink)}
  @media(max-width:900px){.step-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:760px){.bulk-journey{width:calc(100% - 32px)}.bulk-hero{padding-bottom:70px}.bulk-hero>a{margin-bottom:65px}.bulk-hero>div,.step-grid,.state-grid{grid-template-columns:1fr}.bulk-section{padding:75px 0}.dark-section{margin-inline:-16px;padding-inline:16px}.artifact-section figcaption{grid-template-columns:1fr}.principle-flow{grid-template-columns:1fr}.principle-flow i{justify-self:center;transform:rotate(90deg)}.journey-footer{align-items:flex-start;flex-direction:column}}
</style>
